# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
# extract (Owner A) and reranker/ Stage C go through llm_client.get_client.
# With no key both run their keyless fallback -- extract yields no slots, the
# reranker returns its Stage B order.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Force a provider. Empty -> anthropic if ANTHROPIC_API_KEY else groq if
# GROQ_API_KEY. Use groq (free) for local testing, anthropic for the product.
TECHJAM_LLM_PROVIDER=

# Optional model override; ignored when it does not match the chosen provider.
TECHJAM_LLM_MODEL=

# Set to 0 to skip the Stage C LLM rerank even when a key is present.
RERANKER_USE_LLM=1
