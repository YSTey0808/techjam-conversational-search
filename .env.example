# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
# Used by reranker/ for the Stage C LLM rerank. With no key the pipeline runs
# Stage B only: no network calls, no per-turn latency.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Set to 0 to skip the LLM rerank even when a key is present.
RERANKER_USE_LLM=1
